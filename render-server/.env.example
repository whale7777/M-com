# 이 값들은 변환 서버(호스팅 서비스의 Environment 설정)에만 넣으세요. 깃허브에 올리면 안 돼요!
SUPABASE_URL=https://zzvmssovcmaovraebssk.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...            # config.js 에 있는 것과 같은 값
SUPABASE_SERVICE_KEY=...                         # Supabase > Project Settings > API Keys > Secret key(sb_secret_...) 또는 service_role (비밀!)
ALLOWED_ORIGINS=https://whale7777.github.io      # 민혁닷컴 주소(여러 개면 쉼표). 경로(/M-com/)는 빼요
CACHE_MAX_MB=300                                 # 변환 결과 캐시 최대 용량 (넘으면 오래된 것부터 삭제)
